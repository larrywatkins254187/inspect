{
  "name": "forexinspect",
  "version": "2.0.0",
  "private": true,
  "description": "Evidence-first forex broker research: dated, scoped primary evidence, calculators and guides.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/secure.ts dev",
    "dev:raw": "next dev --hostname 127.0.0.1 --port 3417",
    "build": "tsx scripts/secure.ts build",
    "start": "tsx scripts/secure.ts start",
    "start:raw": "next start --hostname 127.0.0.1 --port 3417",
    "migrate": "tsx scripts/cli.ts migrate",
    "seed": "tsx scripts/cli.ts seed",
    "cli": "tsx scripts/cli.ts",
    "worker": "tsx scripts/cli.ts pilot",
    "setup:secrets": "tsx scripts/setup-secrets.ts",
    "secrets:check": "tsx scripts/setup-secrets.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security": "tsx scripts/security-scan.ts",
    "bundle": "tsx scripts/bundle-report.ts",
    "smoke": "tsx scripts/smoke.ts",
    "crawl": "tsx scripts/crawl-report.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm security",
    "build:raw": "next build"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
