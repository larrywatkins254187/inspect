[Unit]
Description=ForexInspect daily source policy/robots review
After=network-online.target

[Service]
Type=oneshot
User=forexinspect
Group=forexinspect
WorkingDirectory=/opt/forexinspect/current
Environment=FOREXINSPECT_SECRETS_FILE=/etc/forexinspect/production.env
ExecStart=/usr/bin/env pnpm cli policy-review --live
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
Nice=10
