[Unit]
Description=ForexInspect comparison slot job
After=network-online.target

[Service]
Type=oneshot
User=forexinspect
Group=forexinspect
WorkingDirectory=/opt/forexinspect/current
Environment=FOREXINSPECT_SECRETS_FILE=/etc/forexinspect/production.env
ExecStart=/usr/bin/env pnpm cli compare-cycle
TimeoutStartSec=2700
NoNewPrivileges=true
PrivateTmp=true
Nice=10
