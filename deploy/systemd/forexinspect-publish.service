[Unit]
Description=ForexInspect scheduled publication (both switches + all gates)
After=network-online.target

[Service]
Type=oneshot
User=forexinspect
Group=forexinspect
WorkingDirectory=/opt/forexinspect/current
Environment=FOREXINSPECT_SECRETS_FILE=/etc/forexinspect/production.env
ExecStart=/usr/bin/env pnpm cli publish-auto
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
Nice=10
