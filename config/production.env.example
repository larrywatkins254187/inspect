# ForexInspect protected configuration — PLACEHOLDERS ONLY. Never commit real values.
# Format: NAME="JSON-quoted string" (parsed, never shell-sourced). Install to /etc/forexinspect/production.env
# (root:forexinspect, mode 0640) or point FOREXINSPECT_SECRETS_FILE at a protected file.
# Credential presence never enables a service: each *_ENABLED switch defaults to "false".

# ── Core ──
# SQLite database file (WAL).
DATABASE_PATH="/opt/forexinspect/data/forexinspect.sqlite"
# development | test | production
APP_ENV="production"
# Canonical HTTPS origin, default https://forexinspect.com
SITE_URL="https://forexinspect.com"
# Admin login token (≥32 chars). (secret)
ADMIN_TOKEN=""
# Honest fetcher user agent with contact.
SOURCE_USER_AGENT="ForexInspectBot/2.0 (+https://forexinspect.com/methodology; contact@example.invalid)"
# Deployment label for safe summaries.
DEPLOYMENT_REGION=""
# Deployment label for safe summaries.
DEPLOYMENT_VPS_ID=""
# Serve eligible published snapshots. Default false.
PUBLICATION_ENABLED="false"
# Allow scheduled publication. Default false.
AUTO_PUBLICATION_ENABLED="false"
# ── Authorization ──
# Owner confirms credentials were rotated after any exposure.
SECRETS_ROTATION_CONFIRMED="false"
# ── AI ──
# Enable local Codex CLI adapter.
CODEX_ENABLED="false"
# Model name passed to codex exec -m.
CODEX_MODEL=""
# Optional codex binary override.
CODEX_BIN=""
# ── AI (historical) ──
# Historical; no Kie adapter is implemented.
KIE_ENABLED="false"
# Historical; unused until a verified adapter exists. (secret)
KIE_API_KEY=""
# Historical Kie spend cap; unused.
AI_DAILY_SPEND_CAP=""
# ── Ask ──
# Enable Ask ForexInspect.
CHAT_ENABLED="false"
# Daily answered-question cap, default 50.
CHAT_DAILY_CREDIT_CAP="50"
# ── Turnstile ──
# Enable Turnstile verification.
TURNSTILE_ENABLED="false"
# Public site key (read at runtime).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Siteverify secret. (secret)
TURNSTILE_SECRET_KEY=""
# Exact hostname expected in siteverify.
TURNSTILE_HOSTNAME=""
# ── Cloudflare ──
# Enable zone status helper.
CLOUDFLARE_ENABLED="false"
# Scoped zone read token. (secret)
CLOUDFLARE_API_TOKEN=""
# Authorized zone id.
CLOUDFLARE_ZONE_ID=""
# ── Telegram ──
# Enable safe summaries/backup upload.
TELEGRAM_ENABLED="false"
# Bot token. (secret)
TELEGRAM_BOT_TOKEN=""
# Authorized group id.
TELEGRAM_CHAT_ID=""
# Local Bot API server infrastructure only. (secret)
TELEGRAM_API_ID=""
# Local Bot API server infrastructure only. (secret)
TELEGRAM_API_HASH=""
# Default http://127.0.0.1:8081
TELEGRAM_BOT_API_URL="http://127.0.0.1:8081"
# ── Backup ──
# 32-byte key file, root-only.
BACKUP_ENCRYPTION_KEY_FILE="/root/.forexinspect/backup.key"
# Local archive directory.
BACKUP_DIRECTORY="/var/backups/forexinspect"
# Owner approved off-host Telegram transport.
BACKUP_TRANSPORT_APPROVED="false"
# ── Search Console ──
# Enable aggregate metrics helper.
GSC_ENABLED="false"
# e.g. sc-domain:forexinspect.com
GSC_PROPERTY_ID=""
# OAuth client id. (secret)
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
# OAuth client secret. (secret)
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""
# OAuth refresh token. (secret)
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=""
# ── IndexNow ──
# Enable IndexNow submissions.
INDEXNOW_ENABLED="false"
# Key; must match public proof file.
INDEXNOW_KEY=""
# ── GoatCounter ──
# Enable GoatCounter helper.
GOATCOUNTER_ENABLED="false"
# GoatCounter site code.
GOATCOUNTER_SITE=""
# API token. (secret)
GOATCOUNTER_API_TOKEN=""
# Legacy, unused by runtime helper. (secret)
GOATCOUNTER_PASSWORD=""
# ── FCA ──
# Requires authorized API usage terms. (secret)
FCA_API_KEY=""
# Account email paired with FCA key. (secret)
FCA_API_EMAIL=""
# ── Host ──
# Operator SSH host.
VPS_HOST=""
# SSH port.
VPS_PORT=""
# SSH user.
VPS_USER=""
# Path only; key stays in operator SSH storage.
VPS_SSH_PRIVATE_KEY_PATH=""
# Strict host key fingerprint.
VPS_SSH_HOST_FINGERPRINT=""
# Must stay inactive; never used. (secret)
VPS_LEGACY_PASSWORD_INACTIVE=""
# ── Analytics ──
# Public GA4 id; loads only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Offer consent-based GA4 on allowlisted routes.
ANALYTICS_ENABLED="false"
# ── Market ──
# Allow ECB-via-Frankfurter refresh (no key).
MARKET_RATES_ENABLED="false"
# ── Contact ──
# Domain for published contact aliases.
CONTACT_EMAIL_DOMAIN="forexinspect.com"
# ── SEO ──
# Constrained code repair; requires git + rollback.
SEO_FIX_ENABLED="false"

# Cloudflare Email Worker bindings (DEST, TG_TOKEN, TG_CHAT) are configured in Cloudflare, not here.
